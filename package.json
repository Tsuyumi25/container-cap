{
  "name": "container-cap",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "dev:firefox": "wxt -b firefox --mv3",
    "build:firefox": "wxt build -b firefox --mv3",
    "zip:firefox": "wxt zip -b firefox --mv3",
    "package": "pnpm build:firefox && web-ext build --source-dir .output/firefox-mv3 --artifacts-dir web-ext-artifacts --filename container-cap.xpi --overwrite-dest --no-config-discovery",
    "typecheck": "vue-tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "@wxt-dev/browser": "0.3.4",
    "vue": "^3.5.29"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/webextension-polyfill": "0.12.6",
    "@wxt-dev/module-vue": "^1.0.3",
    "typescript": "^5.9.3",
    "vue-tsc": "^3.2.5",
    "web-ext": "^10.6.0",
    "wxt": "^0.21.4"
  }
}
